<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <button
                    name="action_open_retention_wizard"
                    id="account_invoice_retention_btn"
                    type="object"
                    string="Escrow/Retention"
                    attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'),
                        ('move_type', 'not in', ('out_invoice', 'out_refund')),
                        ('payment_state', 'in', ('paid', 'in_payment', 'payment_retained', 'reversed'))]}"
                    groups="account.group_account_invoice"
                />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_retention_moves"
                    class="oe_stat_button"
                    icon="fa-lock"
                    type="object"
                    attrs="{'invisible': [('retention_move_count', '=', 0)]}"
                >
                    <field
                        name="retention_move_count"
                        widget="statinfo"
                        string="Escrow/Retention"
                    />
                </button>
            </xpath>

            <xpath expr="//label[@for='journal_id']" position="before">
                <field
                    name="escrow_account_id"
                    attrs="{'invisible': [('escrow_account_id', '=', False)]}"
                />
                <field
                    name="escrow_journal_id"
                    attrs="{'invisible': [('escrow_journal_id', '=', False)]}"
                />
            </xpath>

            <xpath expr="//widget[@name='web_ribbon'][1]" position="after">
                <widget
                    name="web_ribbon"
                    title="Payment Retained"
                    bg_color="bg-info"
                    attrs="{'invisible': ['|', ('payment_state', '!=', 'payment_retained'),
                        ('move_type', 'not in', ('out_invoice', 'out_refund'))]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_retention" model="ir.ui.view">
        <field name="name">account.move.tree.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="payment_state" position="attributes">
                <attribute
                    name="decoration-info"
                >payment_state == 'payment_retained'</attribute>
            </field>
        </field>
    </record>
</odoo>
