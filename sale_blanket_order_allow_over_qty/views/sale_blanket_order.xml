<odoo>
    <record id="view_blanket_order_form" model="ir.ui.view">
        <field
            name="name"
        >view_blanket_order_form (in sale_blanket_order_allow_over_qty)</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='other_information']//group[@name='invoicing']"
                position="inside"
            >
                <field name="allow_over_qty" />
            </xpath>
        </field>
    </record>
</odoo>
